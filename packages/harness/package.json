{
  "name": "@liggi/agent-ui-harness",
  "version": "0.2.3",
  "description": "Manages the lifecycle of an interactive CLI agent process connected to a browser UI",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "bash scripts/check-clean-tree.sh",
    "prepublishOnly": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && echo 'typecheck passed'"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.4",
    "@types/react": "^18.2.66",
    "fast-check": "^3.23.2",
    "jsdom": "^29.0.1",
    "react": "^18.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}

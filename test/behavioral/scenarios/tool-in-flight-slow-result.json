{
  "name": "tool-in-flight-slow-result",
  "description": "Agent emits a Bash tool_use, then waits a long time before the tool_result arrives. Exercises the in-flight activity indicator: the tool name and elapsed time should show while the call is outstanding and revert once the result lands.",
  "events": [
    { "type": "system_init" },
    { "delay": 100, "type": "assistant", "content": [
      { "type": "text", "text": "Let me run a command." },
      { "type": "tool_use", "id": "tool_bash_1", "name": "Bash", "input": { "command": "sleep 3" } }
    ]},
    { "delay": 4000, "type": "raw", "event": {
      "type": "user",
      "message": {
        "role": "user",
        "content": [{ "type": "tool_result", "tool_use_id": "tool_bash_1", "content": "done" }]
      }
    }},
    { "delay": 200, "type": "assistant", "content": [
      { "type": "text", "text": "The command completed." }
    ]},
    { "delay": 50, "type": "result", "duration_ms": 4500 }
  ],
  "on_stdin": {
    "echo": true
  }
}

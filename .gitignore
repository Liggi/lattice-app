# Dependencies
node_modules/
# A worktree gets node_modules as a symlink, which the trailing slash misses.
node_modules

# Build outputs
dist/
dist-staging/
dist-old/
.build.lock
.build.lockdir
build/
*.tsbuildinfo
# Exclude React build output from backend
public/dist/
public/node_modules/

# Environment variables
.env
.env.local
.env.*.local

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Playwright artifacts
test-results/
playwright-report/

# Dependency directories
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# next.js build output
.next

# nuxt.js build output
.nuxt

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# Git worktrees
cc-worktrees/

# Experiments and local databases
experiments/
*.db
!src/**/*.db

# Bundle analysis
analyze-bundle.cjs
bundle-*.html

# Generated vite config
vite.config.mjs
vite.config.mjs.map

# Local documents
documents/

# Local data files (but not banners — those ship with the package)
data/*
!data/banners/

# Runtime state files
session.json
shared-state.jsonl
conversations/

